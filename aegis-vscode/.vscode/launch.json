{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动扩展（打开 aegis-ai 工作区）",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/../"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    },
    {
      "name": "启动扩展（当前工作区）",
      "type": "extensionHost",
      "request": "launch",
      "args": [],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
