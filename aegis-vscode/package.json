{
  "name": "aegis-ai-security",
  "displayName": "Aegis AI Security Scanner",
  "description": "Real-time SAST for JS/TS/Python/PHP/Java/Go plus C/C++ basic scanning with a bundled Aegis backend, AST analysis, taint tracking, baseline suppression, and AI-assisted fixes.",
  "version": "0.6.7",
  "publisher": "wen-zai",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/HWZ-499/aegis-ai.git"
  },
  "bugs": {
    "url": "https://github.com/HWZ-499/aegis-ai/issues"
  },
  "homepage": "https://github.com/HWZ-499/aegis-ai#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "security",
    "sast",
    "sql injection",
    "xss",
    "rce",
    "vulnerability",
    "vulnerability scanner",
    "code analysis",
    "ai auto-fix",
    "security scanner",
    "static analysis",
    "taint analysis",
    "javascript",
    "typescript",
    "python",
    "php",
    "java",
    "go",
    "c",
    "cpp",
    "c++",
    "owasp",
    "deepscan",
    "snyk",
    "sonarqube",
    "copilot"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:php",
    "onLanguage:java",
    "onLanguage:go",
    "onLanguage:c",
    "onLanguage:cpp",
    "onCommand:aegisAI.scanCurrentFile",
    "onCommand:aegisAI.scanWorkspace",
    "onCommand:aegisAI.showOutput",
    "onCommand:aegisAI.showReport",
    "onCommand:aegisAI.removeRemediationComments",
    "onCommand:aegisAI.refreshBaseline",
    "onCommand:aegisAI.removeBaselineEntry",
    "onCommand:aegisAI.toggleSuppressedFindings"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aegisAI.scanCurrentFile",
        "title": "Aegis: Scan Current File",
        "category": "Aegis AI"
      },
      {
        "command": "aegisAI.scanWorkspace",
        "title": "Aegis: Scan Workspace",
        "category": "Aegis AI"
      },
      {
        "command": "aegisAI.showOutput",
        "title": "Aegis: Show Output Log",
        "category": "Aegis AI"
      },
      {
        "command": "aegisAI.showReport",
        "title": "Aegis: Show Report",
        "category": "Aegis AI"
      },
      {
        "command": "aegisAI.previewFix",
        "title": "Aegis: Preview AI Fix",
        "category": "Aegis AI"
      },
      {
        "command": "aegisAI.showTaintPath",
        "title": "Aegis: Show Taint Path",
        "category": "Aegis AI"
      },
      {
        "command": "aegisAI.removeRemediationComments",
        "title": "Aegis: Remove Inserted Remediation Comments",
        "category": "Aegis AI"
      },
      {
        "command": "aegisAI.refreshBaseline",
        "title": "Aegis: Refresh Baseline View",
        "category": "Aegis AI"
      },
      {
        "command": "aegisAI.removeBaselineEntry",
        "title": "Aegis: Remove from Baseline",
        "category": "Aegis AI"
      },
      {
        "command": "aegisAI.toggleSuppressedFindings",
        "title": "Aegis: Toggle Suppressed Findings",
        "category": "Aegis AI"
      }
    ],
    "keybindings": [
      {
        "command": "aegisAI.scanCurrentFile",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "aegisAI.scanWorkspace",
        "key": "ctrl+alt+shift+s",
        "mac": "cmd+alt+shift+s"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aegisSecurity",
          "title": "Aegis Security",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "aegisSecurity": [
        {
          "id": "aegisFindings",
          "name": "Findings"
        },
        {
          "id": "aegisBaseline",
          "name": "Suppressed Findings"
        }
      ]
    },
    "menus": {
        "editor/context": [
        {
          "command": "aegisAI.scanCurrentFile",
          "when": "editorTextFocus",
          "group": "aegis@1"
        },
        {
          "command": "aegisAI.previewFix",
          "when": "editorTextFocus",
          "group": "aegis@2"
        }
      ],
      "explorer/context": [
        {
          "command": "aegisAI.scanCurrentFile",
          "when": "explorerResourceIsFile",
          "group": "aegis@1"
        }
      ],
      "view/item/context": [
        {
          "command": "aegisAI.showTaintPath",
          "when": "viewItem == aegisFindingWithTaintPath",
          "group": "inline"
        },
        {
          "command": "aegisAI.removeBaselineEntry",
          "when": "view == aegisBaseline && viewItem == aegisBaselineEntry",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "aegisAI.toggleSuppressedFindings",
          "when": "view == aegisBaseline",
          "group": "navigation"
        },
        {
          "command": "aegisAI.refreshBaseline",
          "when": "view == aegisBaseline",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aegisFindings",
        "contents": "No security issues found.\n\nOpen a supported file (JS/TS/Python/PHP/Java/Go/C/C++) and save it to trigger a scan, or use the command:\n[Scan Current File](command:aegisAI.scanCurrentFile)\n[Scan Workspace](command:aegisAI.scanWorkspace)"
      }
    ],
    "configuration": {
      "title": "Aegis AI Security Scanner",
      "properties": {
        "aegisAI.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "application",
          "description": "Path to Python 3.10+ used to create and run the Aegis backend environment. Examples: python, python3, /usr/bin/python3, C:\\\\Python311\\\\python.exe"
        },
        "aegisAI.serverModule": {
          "type": "string",
          "default": "src.lsp",
          "scope": "application",
          "description": "Python module path for the Aegis AI LSP Server (e.g., src.lsp)."
        },
        "aegisAI.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the Aegis AI security scanner."
        },
        "aegisAI.serverCwd": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Advanced/development override: force an aegis-ai-core working directory. Leave blank to use the bundled backend."
        },
        "aegisAI.severity.minimum": {
          "type": "string",
          "default": "Low",
          "enum": ["Critical", "High", "Medium", "Low"],
          "description": "Minimum severity level to display. Findings below this level are hidden."
        },
        "aegisAI.excludePatterns": {
          "type": "array",
          "default": ["**/node_modules/**", "**/dist/**", "**/.git/**", "**/vendor/**"],
          "items": { "type": "string" },
          "description": "Legacy exclude patterns. Prefer aegisAI.scan.exclude."
        },
        "aegisAI.scan.exclude": {
          "type": "array",
          "default": ["**/node_modules/**", "**/dist/**", "**/.git/**", "**/vendor/**"],
          "items": { "type": "string" },
          "description": "Glob patterns for files/directories to exclude from scanning."
        },
        "aegisAI.disabledRules": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "List of rule IDs to disable (e.g. [\"HARDCODED_CREDENTIALS\", \"SQL_INJECTION_REGEX\"])."
        },
        "aegisAI.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI-powered fix suggestions. Ollama runs locally without an API key; remote providers require matching AI env vars and a VS Code reload after changes."
        },
        "aegisAI.ai.provider": {
          "type": "string",
          "default": "ollama",
          "enum": ["deepseek", "openai", "ollama", "custom"],
          "description": "AI provider for fix suggestions. The extension passes this value to the Python server as AI_PROVIDER."
        },
        "aegisAI.ai.model": {
          "type": "string",
          "default": "",
          "description": "Optional AI model override for fix suggestions. Leave empty to use the provider default."
        },
        "aegisAI.ai.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional OpenAI-compatible endpoint URL for the selected AI provider. API keys should stay in environment variables or .env."
        },
        "aegisAI.experimental.crossFileAnalysis": {
          "type": "boolean",
          "default": false,
          "description": "Enable experimental cross-file dependency graph analysis."
        },
        "aegisAI.showSuppressedFindings": {
          "type": "boolean",
          "default": false,
          "description": "Show suppressed baseline findings in the Aegis sidebar."
        },
        "aegisAI.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan files on save."
        },
        "aegisAI.scanOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Scan files on text change (with debounce). Disable for better performance on large files."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run prepare-backend && npm run bundle",
    "prepare-backend": "node scripts/prepare-bundled-backend.js",
    "bundle": "node esbuild.js --production",
    "check": "tsc --noEmit -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "watch:esbuild": "node esbuild.js --watch",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "vsce package",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^25.2.2",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.20.0",
    "mocha": "^10.2.0",
    "typescript": "^5.3.0"
  }
}
