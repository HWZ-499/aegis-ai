# 复制为 .env 并填入真实值，或直接设置系统环境变量
# 必填：DeepSeek API Key（禁止写进代码）
DEEPSEEK_API_KEY=sk-your-key-here
# 可选：API 地址，默认如下
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# ===== 第二阶段：缓存/限流/CORS（可选）=====
# DeepSeek 响应缓存：默认 5 分钟、最多 128 条
# DEEPSEEK_CACHE_TTL_SECONDS=300
# DEEPSEEK_CACHE_MAX_ITEMS=128

# 简单限流：每分钟次数（按 IP）
# RATE_LIMIT_CHAT_PER_MIN=30
# RATE_LIMIT_AUDIT_PER_MIN=10

# CORS：允许的 origins，逗号分隔；开发默认 *
# 生产建议填写你的前端域名，例如：
# CORS_ALLOW_ORIGINS=http://localhost:4200,https://your-domain.com
