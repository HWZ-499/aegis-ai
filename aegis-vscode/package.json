{
  "name": "aegis-ai-security",
  "displayName": "Aegis AI Security Scanner",
  "description": "Real-time SAST security scanner — detects SQL injection, NoSQL injection, XSS, RCE, path traversal and more as you type. Powered by Tree-sitter AST analysis + DeepSeek AI auto-fix.",
  "version": "0.2.0",
  "publisher": "aegis-ai",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/aegis-ai/aegis-ai.git"
  },
  "bugs": {
    "url": "https://github.com/aegis-ai/aegis-ai/issues"
  },
  "homepage": "https://github.com/aegis-ai/aegis-ai#readme",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "security",
    "SAST",
    "vulnerability",
    "static analysis",
    "javascript",
    "typescript",
    "python",
    "php",
    "nosql injection",
    "sql injection",
    "xss",
    "rce",
    "owasp"
  ],
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Aegis AI Security Scanner",
      "properties": {
        "aegisAI.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter used to run the Aegis AI LSP Server."
        },
        "aegisAI.serverModule": {
          "type": "string",
          "default": "src.lsp",
          "description": "Python module path for the Aegis AI LSP Server (e.g., src.lsp)."
        },
        "aegisAI.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the Aegis AI security scanner."
        },
        "aegisAI.serverCwd": {
          "type": "string",
          "default": "",
          "description": "强制指定 LSP Server 工作目录（aegis-ai-core 的绝对路径）。留空则自动推断。若诊断不显示可尝试填写，如: C:\\Users\\xxx\\aegis-ai\\aegis-ai-core"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  }
}
