{
  "name": "aegis-ai-security",
  "displayName": "Aegis AI Security Scanner",
  "description": "Real-time SAST scanner with AI auto-fix — SQL/NoSQL injection, XSS, RCE, path traversal across JS/TS/Python/PHP/Java/Go. Tree-sitter AST + taint analysis.",
  "version": "0.3.1",
  "publisher": "wen-zai",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/HWZ-499/aegis-ai.git"
  },
  "bugs": {
    "url": "https://github.com/HWZ-499/aegis-ai/issues"
  },
  "homepage": "https://github.com/HWZ-499/aegis-ai#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "security",
    "SAST",
    "vulnerability",
    "static analysis",
    "javascript",
    "typescript",
    "python",
    "php",
    "java",
    "go",
    "nosql injection",
    "sql injection",
    "xss",
    "rce",
    "owasp"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:php",
    "onLanguage:java",
    "onLanguage:go",
    "onCommand:aegisAI.scanCurrentFile",
    "onCommand:aegisAI.scanWorkspace",
    "onCommand:aegisAI.showOutput",
    "onCommand:aegisAI.showReport"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aegisAI.scanCurrentFile",
        "title": "Aegis: Scan Current File",
        "category": "Aegis AI"
      },
      {
        "command": "aegisAI.scanWorkspace",
        "title": "Aegis: Scan Workspace",
        "category": "Aegis AI"
      },
      {
        "command": "aegisAI.showOutput",
        "title": "Aegis: Show Output Log",
        "category": "Aegis AI"
      },
      {
        "command": "aegisAI.showReport",
        "title": "Aegis: Show Report",
        "category": "Aegis AI"
      }
    ],
    "keybindings": [
      {
        "command": "aegisAI.scanCurrentFile",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aegisSecurity",
          "title": "Aegis Security",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "aegisSecurity": [
        {
          "id": "aegisFindings",
          "name": "Findings"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "aegisAI.scanCurrentFile",
          "when": "editorTextFocus",
          "group": "aegis@1"
        }
      ],
      "explorer/context": [
        {
          "command": "aegisAI.scanCurrentFile",
          "when": "explorerResourceIsFile",
          "group": "aegis@1"
        }
      ]
    },
    "configuration": {
      "title": "Aegis AI Security Scanner",
      "properties": {
        "aegisAI.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter used to run the Aegis AI LSP Server."
        },
        "aegisAI.serverModule": {
          "type": "string",
          "default": "src.lsp",
          "description": "Python module path for the Aegis AI LSP Server (e.g., src.lsp)."
        },
        "aegisAI.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the Aegis AI security scanner."
        },
        "aegisAI.serverCwd": {
          "type": "string",
          "default": "",
          "description": "Force LSP Server working directory (absolute path to aegis-ai-core). Leave blank for auto-detect."
        },
        "aegisAI.severity.minimum": {
          "type": "string",
          "default": "Low",
          "enum": ["Critical", "High", "Medium", "Low"],
          "description": "Minimum severity level to display. Findings below this level are hidden."
        },
        "aegisAI.excludePatterns": {
          "type": "array",
          "default": ["**/node_modules/**", "**/dist/**", "**/.git/**", "**/vendor/**"],
          "items": { "type": "string" },
          "description": "Glob patterns for files/directories to exclude from scanning."
        },
        "aegisAI.disabledRules": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "List of rule IDs to disable (e.g. [\"HARDCODED_CREDENTIALS\", \"SQL_INJECTION_REGEX\"])."
        },
        "aegisAI.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI-powered fix suggestions (requires DEEPSEEK_API_KEY or OPENAI_API_KEY)."
        },
        "aegisAI.ai.provider": {
          "type": "string",
          "default": "deepseek",
          "enum": ["deepseek", "openai"],
          "description": "AI provider for fix suggestions."
        },
        "aegisAI.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan files on save."
        },
        "aegisAI.scanOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Scan files on text change (with debounce). Disable for better performance on large files."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "vsce package",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^25.2.2",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.2.1",
    "mocha": "^10.2.0",
    "typescript": "^5.3.0"
  }
}
